// Prisma schema for CommerceAgent — SQLite audit log & agent run history

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id // readable ids set by the seed (e.g. "prod_espresso_machine")
  name         String   @unique
  description  String
  priceInPaise Int // smallest currency unit (paise)
  imageUrl     String?
  category     String
  stock        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

model Order {
  id                    String   @id @default(cuid())
  razorpayOrderId       String   @unique
  razorpayPaymentLinkId String?
  razorpayPaymentId     String?
  amountInPaise         Int
  currency              String   @default("INR")
  receipt               String?
  // CREATED | LINK_SENT | PAID | FAILED
  status                String   @default("CREATED")
  notes                 String? // JSON string
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
}

model AuditLog {
  id                String    @id @default(cuid())
  // Agent metadata
  agentType         String // e.g. "payment-link" | "refund" | "payment-status"
  action            String // e.g. "create_payment_link" | "refund_payment"
  status            String // "SUCCESS" | "FAILED" | "BLOCKED"
  // Guardrail metadata (populated when a run is blocked)
  blockedReason     String?
  // Agent reasoning (multi-agent system: GROWTH / CHECKOUT / GUARDIAN)
  reasoning         String?
  // Request/response payloads stored as JSON strings (SQLite-friendly)
  input             String
  output            String?
  error             String?
  // Money fields are stored in the smallest currency unit (paise)
  amountInPaise     Int?
  currency          String?
  // Razorpay identifiers
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpayRefundId  String?
  // Correlation
  requestId         String?
  createdAt         DateTime  @default(now())

  @@index([agentType])
  @@index([status])
  @@index([createdAt])
}
