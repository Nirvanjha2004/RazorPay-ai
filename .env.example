# ── Razorpay (required for real orders — test mode) ──────────────────
# Dashboard → Settings → API Keys → Generate Test Key
# Test keys look like rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_test_mode_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret" # Dashboard → Settings → Webhooks → Add Webhook

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db" # SQLite (default). For Postgres: postgresql://user:pass@host/db

# ── App URL (used for OpenRouter ranking headers + webhooks) ──────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── LLM — pick ONE ────────────────────────────────────────────────────
# Option A: OpenRouter (recommended — free models, no billing)
# Get key: https://openrouter.ai/keys → Create Key (free, no card)
OPENROUTER_API_KEY=""
# Any OpenRouter model; :free models cost $0. Tools need a tool-caller:
#   inclusionai/ling-3.0-flash-sante:free  ← active for this project
#   openai/gpt-oss-20b:free  ← best free tool-caller fallback
#   meta-llama/llama-3.1-8b-instruct:free
#   google/gemma-2-9b-it:free
OPENAI_MODEL="inclusionai/ling-3.0-flash-sante:free"
# Optional override — defaults to https://openrouter.ai/api/v1 when OPENROUTER_API_KEY is set
# OPENAI_BASE_URL="https://openrouter.ai/api/v1"

# Option B: OpenAI directly
# Get key: https://platform.openai.com/api-keys → Create new secret key
# OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-4o-mini"

# ── Guardrails (amounts in paise; ₹1 = 100 paise) ─────────────────────
MAX_SESSION_SPEND="200000"                # ₹2,000 per session
MAX_SESSION_ORDERS="3"
HUMAN_APPROVAL_THRESHOLD_PAISE="100000"   # ₹1,000 → needs human approve
# Legacy guardrail overrides (executor path):
# GUARDRAIL_PER_ACTION_CAP_PAISE="100000" # ₹1,000 per action
# GUARDRAIL_DAILY_CAP_PAISE="500000"      # ₹5,000 per day
# GUARDRAIL_DAILY_REFUND_CAP="10"
# GUARDRAIL_REFUND_ALLOWLIST="false"      # set false to disable allowlist
# GUARDRAIL_REFUND_ALLOWLIST_IDS="pay_xxx,pay_yyy"
# PRODUCT_ALLOWLIST="prod_milk_pitcher,prod_coffee_scale"
